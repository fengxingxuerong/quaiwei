{
  "name": "qu-ai-wei",
  "version": "0.9.75",
  "description": "趣AI味 · 离线 AI 文本去味工具（Electron 桌面版）",
  "main": "main.js",
  "author": "飞行雪绒",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . QuAiWei --platform=win32 --arch=x64 --out=../electron-dist --overwrite --no-asar",
    "repack": "node rebuild-app.cjs && node prune-dist.cjs && node verify-pruned.cjs",
    "prune": "node prune-dist.cjs",
    "verify": "node verify-pruned.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^43.2.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
