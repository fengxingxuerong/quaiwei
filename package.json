{
  "name": "ai-humanizer",
  "version": "0.9.79",
  "type": "module",
  "main": "index.js",
  "description": "趣AI味 · 本地离线可用、可选接 LLM 的中文 AI 文本拟人化工具，对标朱雀",
  "license": "MIT",
  "author": "飞行雪绒",
  "homepage": "https://fengxingxuerong.github.io/quaiwei/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengxingxuerong/quaiwei.git"
  },
  "bugs": {
    "url": "https://github.com/fengxingxuerong/quaiwei/issues"
  },
  "keywords": [
    "ai-humanizer",
    "humanize-ai-text",
    "chinese",
    "去ai味",
    "朱雀",
    "ai-text",
    "text-rewriting",
    "offline",
    "cli"
  ],
  "bin": {
    "ai-humanizer": "dist-cli/humanize-cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist-cli",
    "index.js",
    "cordis.patch.yml",
    ".dsh",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/sync-dist.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build:cli",
    "setup:hooks": "node scripts/install-hooks.mjs",
    "make:zip": "node scripts/make-zip.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "probe:models": "node scripts/probe-sensenova.mjs",
    "compare:models": "node scripts/model-compare.mjs",
    "sweep:fidelity": "node scripts/fidelity-sweep.mjs",
    "preview": "vite preview",
    "test:engine": "vitest run src/engine/humanize.test.ts",
    "test:regress": "tsx scripts/scan-bugs.ts",
    "test:realcase": "tsx scripts/realcase/run.ts --matrix",
    "test:regress12": "tsx scripts/regression-12samples.ts",
    "test:quality": "tsx scripts/verify-quality.ts",
    "test:improve": "tsx scripts/regression-improve.ts --samples scripts/regression-improve.samples.json",
    "test:calib": "tsx scripts/calib-sanity.ts",
    "test:evidence": "tsx scripts/zhuque-evidence.ts audit",
    "seal:api": "tsx scripts/zhuque-evidence.ts sealApi",
    "score:official": "tsx scripts/zhuque-official-run.ts",
    "check:ledger": "tsx scripts/check-ledger-appendonly.ts",
    "check:version": "tsx scripts/check-version-sync.ts",
    "check:regex": "tsx scripts/check-regex-defects.ts",
    "check:release": "npm run check:version && npm run check:regex && npm run test:cov && npm run test:regress && npm run test:realcase && npm run test:regress12 && npm run test:quality && npm run test:improve && npm run test:calib && npm run test:evidence && npm run check:ledger",
    "check:publish": "tsx scripts/zhuque-evidence.ts audit --strict",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest run",
    "test:cov": "tsx scripts/coverage-gate.ts",
    "lint": "eslint src/ scripts/",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,json,mjs}\" \"vite.config.ts\"",
    "build:electron": "tsc -b && vite build && node scripts/sync-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
